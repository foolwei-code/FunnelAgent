# FunnelRAG 环境变量配置（复制为 .env 使用）
# ====== LLM (Qwen 通义千问) ======
LLM_PROVIDER=openai
LLM_MODEL_NAME=qwen-plus
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://ws-cvbkn0izrwzsi71j.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ====== Milvus ======
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=funnelrag_docs
MILVUS_TOP_K=100

# ====== 精排服务 ======
RERANKER_HOST=localhost
RERANKER_PORT=50051
RERANKER_MODEL_PATH=cpp/model/cross_encoder.onnx
RERANKER_TIMEOUT=0.05

# ====== PostgreSQL ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456abc
POSTGRES_DB=funnelrag

# ====== Redis ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456abc

# ====== LangSmith ======
LANGSMITH_API_KEY=

# ====== 应用 ======
DEBUG=false
LOG_LEVEL=INFO
